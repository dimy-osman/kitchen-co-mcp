{
  "name": "kitchen-co-mcp",
  "displayName": "Kitchen.co MCP (Unofficial)",
  "description": "Unofficial community MCP bridge for the Kitchen.co API (by Dimy Osman). NOT affiliated with or endorsed by Kitchen.co. Use your own API token. AS IS — no warranty.",
  "version": "0.1.2",
  "publisher": "dimy-osman",
  "author": {
    "name": "Dimy Osman"
  },
  "license": "MIT",
  "homepage": "https://github.com/dimy-osman/kitchen-co-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimy-osman/kitchen-co-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dimy-osman/kitchen-co-mcp/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "kitchen",
    "kitchen.co",
    "mcp",
    "cursor",
    "api",
    "KTCH-MCP",
    "unofficial"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kitchenMcp.about",
        "title": "Kitchen.co MCP: About / Disclaimer"
      },
      {
        "command": "kitchenMcp.addProfile",
        "title": "Kitchen.co MCP: Add Profile"
      },
      {
        "command": "kitchenMcp.editProfile",
        "title": "Kitchen.co MCP: Edit Profile"
      },
      {
        "command": "kitchenMcp.removeProfile",
        "title": "Kitchen.co MCP: Remove Profile"
      },
      {
        "command": "kitchenMcp.listProfiles",
        "title": "Kitchen.co MCP: List Profiles"
      },
      {
        "command": "kitchenMcp.reregister",
        "title": "Kitchen.co MCP: Re-register MCP Servers"
      },
      {
        "command": "kitchenMcp.testConnection",
        "title": "Kitchen.co MCP: Test Connection"
      },
      {
        "command": "kitchenMcp.showLog",
        "title": "Kitchen.co MCP: Show Output Log"
      }
    ],
    "configuration": {
      "title": "Kitchen.co MCP (Unofficial)",
      "properties": {
        "kitchenMcp.autoRegister": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync Kitchen MCP servers on startup (durable mcp.json + Cursor registerServer)."
        },
        "kitchenMcp.persistToUserMcpJson": {
          "type": "boolean",
          "default": true,
          "description": "Write/merge Kitchen servers into ~/.cursor/mcp.json so they survive window reload. API keys stay in SecretStorage + a local envFile (never plaintext in mcp.json)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:ext && npm run compile:mcp",
    "compile:ext": "tsc -p ./",
    "compile:mcp": "tsc -p ./mcp",
    "watch": "tsc -watch -p ./",
    "watch:mcp": "tsc -watch -p ./mcp",
    "package": "npm run compile && vsce package",
    "lint": "tsc -p ./ --noEmit && tsc -p ./mcp --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.8.2"
  }
}
