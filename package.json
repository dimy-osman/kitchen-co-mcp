{
  "name": "kitchen-co-mcp",
  "displayName": "Kitchen.co MCP (Unofficial)",
  "description": "Unofficial community MCP bridge for the Kitchen.co API (by Dimy Osman). Not affiliated with or endorsed by Kitchen.co. Use your own API token.",
  "version": "0.2.3",
  "publisher": "dimy-osman",
  "author": {
    "name": "Dimy Osman"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0F766E",
    "theme": "dark"
  },
  "homepage": "https://github.com/dimy-osman/kitchen-co-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/dimy-osman/kitchen-co-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dimy-osman/kitchen-co-mcp/issues"
  },
  "qna": "https://github.com/dimy-osman/kitchen-co-mcp/issues",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "kitchen",
    "kitchen.co",
    "mcp",
    "cursor",
    "api",
    "unofficial"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Profiles and secrets are stored in user global state / SecretStorage, not the workspace."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "kitchenMcp.about",
        "title": "Kitchen.co MCP: About / Disclaimer"
      },
      {
        "command": "kitchenMcp.addProfile",
        "title": "Kitchen.co MCP: Add Profile"
      },
      {
        "command": "kitchenMcp.editProfile",
        "title": "Kitchen.co MCP: Edit Profile"
      },
      {
        "command": "kitchenMcp.removeProfile",
        "title": "Kitchen.co MCP: Remove Profile"
      },
      {
        "command": "kitchenMcp.listProfiles",
        "title": "Kitchen.co MCP: List Profiles"
      },
      {
        "command": "kitchenMcp.reregister",
        "title": "Kitchen.co MCP: Re-register MCP Servers"
      },
      {
        "command": "kitchenMcp.testConnection",
        "title": "Kitchen.co MCP: Test Connection"
      },
      {
        "command": "kitchenMcp.showLog",
        "title": "Kitchen.co MCP: Show Output Log"
      }
    ],
    "configuration": {
      "title": "Kitchen.co MCP (Unofficial)",
      "properties": {
        "kitchenMcp.autoRegister": {
          "type": "boolean",
          "default": true,
          "description": "Automatically sync Kitchen MCP servers on startup (durable mcp.json + Cursor registerServer)."
        },
        "kitchenMcp.persistToUserMcpJson": {
          "type": "boolean",
          "default": true,
          "description": "Write/merge Kitchen servers into ~/.cursor/mcp.json so they survive window reload. Never writes plaintext API keys into mcp.json."
        },
        "kitchenMcp.writePlaintextEnvFile": {
          "type": "boolean",
          "default": true,
          "description": "Materialize short-lived 0600 env files under globalStorage so Cursor can spawn durable MCP servers. Disable to use OS env ${env:VAR} only (more secure, more setup)."
        },
        "kitchenMcp.wipeEnvFilesOnDeactivate": {
          "type": "boolean",
          "default": true,
          "description": "Overwrite and delete materialized env files when the extension deactivates. Keys remain in SecretStorage + encrypted vault and are rematerialized on next activate."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:ext && npm run compile:mcp",
    "compile:ext": "tsc -p ./",
    "compile:mcp": "tsc -p ./mcp",
    "watch": "tsc -watch -p ./",
    "watch:mcp": "tsc -watch -p ./mcp",
    "package": "npm run compile && vsce package",
    "lint": "tsc -p ./ --noEmit && tsc -p ./mcp --noEmit",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.2",
    "typescript": "^5.8.2"
  }
}
